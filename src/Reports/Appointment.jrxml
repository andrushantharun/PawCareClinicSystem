	<query language="SQL"><![CDATA[SELECT a.appointment_id, c.full_name AS customer_name, p.pet_name,
       s.service_name, s.price AS service_price, u.full_name AS staff_name,
       a.appointment_date, a.appointment_time, a.status
FROM appointments a
JOIN customers c ON a.customer_id = c.customer_id
JOIN pets p ON a.pet_id = p.pet_id
JOIN services s ON a.service_id = s.service_id
JOIN users u ON a.user_id = u.user_id
ORDER BY a.appointment_date, a.appointment_time]]></query>
